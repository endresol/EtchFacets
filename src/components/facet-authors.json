{
	"name": "Facet - Authors",
	"key": "FacetAuthors",
	"description": "",
	"properties": [
		{
			"name": "Text Name",
			"key": "textName",
			"type": {
				"primitive": "string"
			}
		},
		{
			"name": "Label",
			"key": "label",
			"type": {
				"primitive": "string"
			},
			"default": "Author"
		},
		{
			"name": "Collapsible",
			"key": "collapsible",
			"type": {
				"primitive": "boolean"
			},
			"default": true
		},
		{
			"name": "Start Open",
			"key": "startOpen",
			"type": {
				"primitive": "boolean"
			},
			"default": "{false}"
		},
		{
			"name": "Logic",
			"key": "logic",
			"type": {
				"primitive": "string",
				"specialized": "select"
			},
			"default": "or",
			"selectOptionsString": "or\nand"
		}
	],
	"blocks": [
		{
			"type": "etch/element",
			"version": 1,
			"tag": "div",
			"context": {
				"name": "Facet"
			},
			"attributes": {
				"class": "resources__facet",
				"data-etchfacet": "{props.textName}",
				"data-etchfacet-collapsible": "{props.collapsible}",
				"data-etchfacet-logic": "{props.logic}",
				"data-etchfacet-open": "{props.startOpen}",
				"data-etchfacet-source": "author"
			},
			"options": {},
			"children": [
				{
					"type": "etch/element",
					"version": 1,
					"tag": "div",
					"context": {},
					"attributes": {
						"class": "etchfacets-facet-header"
					},
					"options": {},
					"children": [
						{
							"type": "etch/condition",
							"version": 1,
							"context": {},
							"conditionString": "props.label !== \"\"",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "h3",
									"context": {},
									"attributes": {
										"class": "etchfacets-facet-label"
									},
									"options": {},
									"children": [
										{
											"type": "etch/text",
											"version": 1,
											"context": {
												"name": "Text"
											},
											"text": "{props.label}",
											"options": {},
											"children": []
										}
									]
								}
							]
						},
						{
							"type": "etch/condition",
							"version": 1,
							"context": {},
							"conditionString": "props.collapsible === true",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "button",
									"context": {
										"name": "Toggle"
									},
									"attributes": {
										"aria-expanded": "{props.startOpen}",
										"class": "etchfacets-facet-toggle",
										"type": "button"
									},
									"options": {},
									"children": [
										{
											"type": "etch/element",
											"version": 1,
											"tag": "span",
											"context": {
												"name": "Etchfacets Facet Toggle Icon"
											},
											"attributes": {
												"aria-hidden": "true",
												"class": "etchfacets-facet-toggle-icon"
											},
											"options": {},
											"children": [
												{
													"type": "etch/svg",
													"version": 1,
													"context": {
														"name": "Svg"
													},
													"attributes": {
														"class": "etchfacets-facet-toggle-icon__svg",
														"src": "{{etchfacets_url}}assets/icons/circle-chevron-down-stroke-rounded.svg"
													},
													"options": {},
													"children": []
												}
											]
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "etch/element",
					"version": 1,
					"tag": "fieldset",
					"context": {
						"name": "Div"
					},
					"attributes": {
						"class": "etchfacets-facet-choices"
					},
					"options": {},
					"children": [
						{
							"type": "etch/condition",
							"version": 1,
							"context": {
								"name": "If label"
							},
							"conditionString": "props.label !== \"\"",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "legend",
									"context": {
										"name": "Legend"
									},
									"attributes": {
										"class": "etchfacets-facet-legend"
									},
									"options": {},
									"children": [
										{
											"type": "etch/text",
											"version": 1,
											"context": {
												"name": "Text"
											},
											"text": "{props.label}",
											"options": {},
											"children": []
										}
									]
								}
							]
						},
						{
							"type": "etch/loop",
							"version": 1,
							"context": {
								"name": "Loop"
							},
							"loopId": "5becw9e",
							"itemId": "author",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "label",
									"context": {
										"name": "Facet Option"
									},
									"attributes": {
										"class": "resources__facet-option"
									},
									"options": {},
									"children": [
										{
											"type": "etch/element",
											"version": 1,
											"tag": "input",
											"context": {
												"name": "Input"
											},
											"attributes": {
												"type": "checkbox",
												"value": "2"
											},
											"options": {},
											"children": []
										},
										{
											"type": "etch/text",
											"version": 1,
											"context": {
												"name": "Text"
											},
											"text": "{author.displayName}",
											"options": {},
											"children": []
										},
										{
											"type": "etch/element",
											"version": 1,
											"tag": "span",
											"context": {},
											"attributes": {
												"class": "etchfacet-count"
											},
											"options": {},
											"children": []
										}
									]
								}
							]
						}
					]
				}
			]
		}
	]
}
