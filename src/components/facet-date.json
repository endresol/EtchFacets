{
	"name": "Facet - Date",
	"key": "FacetDate",
	"description": "EtchFacets date-range facet. Two plain date inputs — no server-computed bounds or live counts apply to date sources.",
	"properties": [
		{
			"name": "Name",
			"key": "name",
			"type": {
				"primitive": "string"
			},
			"default": ""
		},
		{
			"name": "Logic",
			"key": "logic",
			"type": {
				"primitive": "string"
			},
			"default": "or"
		},
		{
			"name": "Label",
			"key": "label",
			"type": {
				"primitive": "string"
			},
			"default": ""
		},
		{
			"name": "Collapsible",
			"key": "collapsible",
			"type": {
				"primitive": "boolean"
			},
			"default": false
		},
		{
			"name": "Start Open",
			"key": "startOpen",
			"type": {
				"primitive": "boolean"
			},
			"default": true
		}
	],
	"blocks": [
		{
			"type": "etch/element",
			"version": 1,
			"tag": "div",
			"context": {
				"name": "Facet Date Root"
			},
			"attributes": {
				"class": "etchfacets-facet",
				"data-etchfacet": "{props.name}",
				"data-etchfacet-collapsible": "{props.collapsible}",
				"data-etchfacet-logic": "{props.logic}",
				"data-etchfacet-open": "{props.startOpen}",
				"data-etchfacet-source": "date"
			},
			"options": {},
			"children": [
				{
					"type": "etch/element",
					"version": 1,
					"tag": "div",
					"context": {},
					"attributes": {
						"class": "etchfacets-facet-header"
					},
					"options": {},
					"children": [
						{
							"type": "etch/condition",
							"version": 1,
							"context": {},
							"conditionString": "props.label !== \"\"",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "h3",
									"context": {},
									"attributes": {
										"class": "etchfacets-facet-label"
									},
									"options": {},
									"children": [
										{
											"type": "etch/text",
											"version": 1,
											"context": {
												"name": "Text"
											},
											"text": "{props.label}",
											"options": {},
											"children": []
										}
									]
								}
							]
						},
						{
							"type": "etch/condition",
							"version": 1,
							"context": {},
							"conditionString": "props.collapsible === true",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "button",
									"context": {
										"name": "Toggle"
									},
									"attributes": {
										"aria-expanded": "{props.startOpen}",
										"class": "etchfacets-facet-toggle",
										"type": "button"
									},
									"options": {},
									"children": [
										{
											"type": "etch/element",
											"version": 1,
											"tag": "span",
											"context": {
												"name": "Etchfacets Facet Toggle Icon"
											},
											"attributes": {
												"aria-hidden": "true",
												"class": "etchfacets-facet-toggle-icon"
											},
											"options": {},
											"children": [
												{
													"type": "etch/svg",
													"version": 1,
													"context": {
														"name": "Svg"
													},
													"attributes": {
														"class": "etchfacets-facet-toggle-icon__svg",
														"src": "{{etchfacets_url}}assets/icons/circle-chevron-down-stroke-rounded.svg"
													},
													"options": {},
													"children": []
												}
											]
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "etch/element",
					"version": 1,
					"tag": "fieldset",
					"context": {},
					"attributes": {
						"class": "etchfacets-facet-choices"
					},
					"options": {},
					"children": [
						{
							"type": "etch/condition",
							"version": 1,
							"context": {
								"name": "If label"
							},
							"conditionString": "props.label !== \"\"",
							"options": {},
							"children": [
								{
									"type": "etch/element",
									"version": 1,
									"tag": "legend",
									"context": {
										"name": "Legend"
									},
									"attributes": {
										"class": "etchfacets-facet-legend"
									},
									"options": {},
									"children": [
										{
											"type": "etch/text",
											"version": 1,
											"context": {
												"name": "Text"
											},
											"text": "{props.label}",
											"options": {},
											"children": []
										}
									]
								}
							]
						},
						{
							"type": "etch/element",
							"version": 1,
							"tag": "input",
							"context": {
								"name": "Min"
							},
							"attributes": {
								"class": "etchfacet-min",
								"type": "date"
							},
							"options": {},
							"children": []
						},
						{
							"type": "etch/element",
							"version": 1,
							"tag": "span",
							"context": {},
							"attributes": {
								"aria-hidden": "true",
								"class": "etchfacets-range-separator"
							},
							"options": {},
							"children": [
								{
									"type": "etch/text",
									"version": 1,
									"context": {
										"name": "Text"
									},
									"text": "–",
									"options": {},
									"children": []
								}
							]
						},
						{
							"type": "etch/element",
							"version": 1,
							"tag": "input",
							"context": {
								"name": "Max"
							},
							"attributes": {
								"class": "etchfacet-max",
								"type": "date"
							},
							"options": {},
							"children": []
						},
						{
							"type": "etch/element",
							"version": 1,
							"tag": "button",
							"context": {
								"name": "Reset"
							},
							"attributes": {
								"aria-label": "Reset date range",
								"class": "etchfacets-range-reset",
								"type": "button"
							},
							"options": {},
							"children": [
								{
									"type": "etch/text",
									"version": 1,
									"context": {
										"name": "Text"
									},
									"text": "↺",
									"options": {},
									"children": []
								}
							]
						}
					]
				}
			]
		}
	]
}
